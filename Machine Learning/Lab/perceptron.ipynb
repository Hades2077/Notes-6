# Perceptron function
def perceptron(x1, w1, x2, w2):
    bias = -0.4
    net = x1 * w1 + x2 * w2 + bias
    
    if net >= 1:
        return 1
    else:
        return 0


print("Enter weights w1, w2")
w1 = float(input())
w2 = float(input())

x1 = [0, 0, 1, 1]
x2 = [0, 1, 0, 1]

n = 0.2  # learning rate

for i in range(len(x1)):
    ox = perceptron(x1[i], w1, x2[i], w2)

    if x1[i] == 1 and x2[i] == 1:
        tx = 1
    else:
        tx = 0

    if ox != tx:
        w1 = w1 + n * (tx - ox) * x1[i]
        w2 = w2 + n * (tx - ox) * x2[i]

print("Updated weights:")
print("w1 =", w1)
print("w2 =", w2)
